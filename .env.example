# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── Google Drive auto-upload ──────────────────────────────────────────────────
# All videos are saved to DRIVE_FOLDER_ID.
# Exact 2.00 winners are saved to DRIVE_WINNER_FOLDER_ID (falls back to DRIVE_FOLDER_ID).
#
# Setup (one-time):
#   1. Go to console.cloud.google.com → New project → Enable "Google Drive API"
#   2. IAM → Service Accounts → Create → Download JSON key
#   3. Open Google Drive, create two folders: "Submissions" and "Winners"
#   4. Share each folder with the service account email (Editor role)
#   5. Copy the folder IDs from each folder's URL:
#      drive.google.com/drive/folders/<FOLDER_ID>
#   6. Paste service account values below (keep GOOGLE_PRIVATE_KEY in one line with \n)

GOOGLE_CLIENT_EMAIL="my-service-account@my-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
DRIVE_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWx"
DRIVE_WINNER_FOLDER_ID="1WiNnErFoLdErIdGoEsHeRe"

# repurpose.io webhook secret (optional but recommended)
# Set the same value in repurpose.io → Settings → Notifications → Secret
REPURPOSE_WEBHOOK_SECRET="any-random-string-you-choose"
